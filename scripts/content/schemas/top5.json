{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Top five list",
  "description": "Front matter of content/top5/*.md. The intro is the markdown body.",
  "type": "object",
  "required": [
    "title",
    "author",
    "date",
    "items"
  ],
  "properties": {
    "title": {
      "$ref": "defs.json#/$defs/text"
    },
    "author": {
      "$ref": "defs.json#/$defs/author"
    },
    "date": {
      "$ref": "defs.json#/$defs/date"
    },
    "caption": {
      "$ref": "defs.json#/$defs/text",
      "description": "Image caption, kept from the legacy data."
    },
    "image": {
      "$ref": "defs.json#/$defs/image"
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text. Empty marks the picture as decorative."
    },
    "image_width": {
      "$ref": "defs.json#/$defs/pixels",
      "description": "Display width, only when the page shows the picture scaled."
    },
    "image_height": {
      "$ref": "defs.json#/$defs/pixels"
    },
    "image_full": {
      "$ref": "defs.json#/$defs/image",
      "description": "Larger version of the picture."
    },
    "draft": {
      "const": true,
      "description": "Not published. Omit the field for published items."
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "description": "Number one first.",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "defs.json#/$defs/markdown"
          },
          "film": {
            "$ref": "defs.json#/$defs/markdown",
            "description": "The film a person or scene is from."
          },
          "text": {
            "$ref": "defs.json#/$defs/markdown"
          }
        }
      }
    },
    "honorable_mentions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "defs.json#/$defs/markdown"
          },
          "text": {
            "$ref": "defs.json#/$defs/markdown"
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "image_alt": [
      "image"
    ],
    "image": [
      "image_alt"
    ],
    "image_width": [
      "image",
      "image_height"
    ],
    "image_height": [
      "image",
      "image_width"
    ],
    "image_full": [
      "image"
    ]
  }
}
