{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Top five list",
  "description": "Front matter of content/top5/*.md. The intro is the markdown body.",
  "type": "object",
  "required": [
    "title",
    "author",
    "date",
    "item_1",
    "item_2",
    "item_3",
    "item_4",
    "item_5"
  ],
  "properties": {
    "title": {
      "$ref": "defs.json#/$defs/text"
    },
    "author": {
      "$ref": "defs.json#/$defs/author"
    },
    "date": {
      "$ref": "defs.json#/$defs/date"
    },
    "caption": {
      "$ref": "defs.json#/$defs/text",
      "description": "Image caption, kept from the legacy data."
    },
    "image": {
      "$ref": "defs.json#/$defs/image"
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text. Empty marks the picture as decorative."
    },
    "image_width": {
      "$ref": "defs.json#/$defs/pixels",
      "description": "Display width, only when the page shows the picture scaled."
    },
    "image_height": {
      "$ref": "defs.json#/$defs/pixels"
    },
    "image_full": {
      "$ref": "defs.json#/$defs/image",
      "description": "Larger version of the picture."
    },
    "draft": {
      "const": true,
      "description": "Not published. Omit the field for published items."
    },
    "item_1": {
      "$ref": "#/$defs/slot",
      "required": [
        "title"
      ],
      "description": "Number 1."
    },
    "item_2": {
      "$ref": "#/$defs/slot",
      "required": [
        "title"
      ],
      "description": "Number 2."
    },
    "item_3": {
      "$ref": "#/$defs/slot",
      "required": [
        "title"
      ],
      "description": "Number 3."
    },
    "item_4": {
      "$ref": "#/$defs/slot",
      "required": [
        "title"
      ],
      "description": "Number 4."
    },
    "item_5": {
      "$ref": "#/$defs/slot",
      "required": [
        "title"
      ],
      "description": "Number 5."
    },
    "honorable_mentions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "image_alt": [
      "image"
    ],
    "image": [
      "image_alt"
    ],
    "image_width": [
      "image",
      "image_height"
    ],
    "image_height": [
      "image",
      "image_width"
    ],
    "image_full": [
      "image"
    ]
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "defs.json#/$defs/markdown"
        },
        "subtitle": {
          "$ref": "defs.json#/$defs/markdown",
          "description": "more context about the movie, person, or scene"
        },
        "text": {
          "$ref": "defs.json#/$defs/markdown"
        }
      },
      "description": "One of the five entries.",
      "minProperties": 1
    }
  }
}
