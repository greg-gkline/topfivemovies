{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "description": "Front matter of content/reviews/*.md (movie and DVD reviews).",
  "type": "object",
  "required": [
    "type",
    "title",
    "author",
    "date",
    "rating",
    "release_year",
    "starring"
  ],
  "properties": {
    "type": {
      "enum": [
        "movie",
        "dvd"
      ]
    },
    "title": {
      "$ref": "defs.json#/$defs/text"
    },
    "subtitle": {
      "$ref": "defs.json#/$defs/text"
    },
    "author": {
      "$ref": "defs.json#/$defs/author"
    },
    "date": {
      "$ref": "defs.json#/$defs/date"
    },
    "caption": {
      "$ref": "defs.json#/$defs/text",
      "description": "Image caption, kept from the legacy data."
    },
    "image": {
      "$ref": "defs.json#/$defs/image"
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text. Empty marks the picture as decorative."
    },
    "image_width": {
      "$ref": "defs.json#/$defs/pixels",
      "description": "Display width, only when the page shows the picture scaled."
    },
    "image_height": {
      "$ref": "defs.json#/$defs/pixels"
    },
    "image_full": {
      "$ref": "defs.json#/$defs/image",
      "description": "Larger version of the picture."
    },
    "draft": {
      "const": true,
      "description": "Not published. Omit the field for published items."
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "multipleOf": 0.5
    },
    "release_year": {
      "type": "integer",
      "minimum": 1890,
      "maximum": 2100
    },
    "starring": {
      "$ref": "defs.json#/$defs/text"
    }
  },
  "additionalProperties": false,
  "dependentRequired": {
    "image_alt": [
      "image"
    ],
    "image": [
      "image_alt"
    ],
    "image_width": [
      "image",
      "image_height"
    ],
    "image_height": [
      "image",
      "image_width"
    ],
    "image_full": [
      "image"
    ]
  }
}
