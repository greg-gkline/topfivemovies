{
  "ci": {
    "collect": {
      "staticDistDir": "public",
      "url": [
        "http://localhost/index.html",
        "http://localhost/reviews.html",
        "http://localhost/reviews/arlington-road.html",
        "http://localhost/top5/top-5-time-concepts.html",
        "http://localhost/authors.html",
        "http://localhost/authors/matt.html",
        "http://localhost/groupbio.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "errors-in-console": "error",
        "font-size": "error",
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 50
          }
        ],
        "resource-summary:document:size": [
          "error",
          {
            "maxNumericValue": 60000
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 12000
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 6000
          }
        ],
        "resource-summary:image:size": [
          "error",
          {
            "maxNumericValue": 150000
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 250000
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".cache/lighthouse"
    }
  }
}
